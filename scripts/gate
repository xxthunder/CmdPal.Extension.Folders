#!/usr/bin/env sh
set -eu
cd "$(dirname "$0")/.."
exec docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -e DOTNET_CLI_HOME=/tmp -e DOTNET_NOLOGO=1 -v "$PWD":/src -w /src mcr.microsoft.com/dotnet/sdk:10.0 sh -c 'dotnet build tools/catalog.cs && dotnet test tests/FoldersCatalog.Tests/FoldersCatalog.Tests.csproj'
